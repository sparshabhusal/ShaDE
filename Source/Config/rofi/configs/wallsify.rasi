/* Rofi Config */

@theme "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    modi:                        "drun";
    font:                        "JetBrainsMono Nerd Font 12.5";
    font-weight:                 bold;
    show-icons:                  true;
    drun-display-format:         "{name}";
    hover-select:                true;
    me-select-entry:             "MouseSecondary";
    me-accept-entry:             "MousePrimary";
    window-format:               "{w} · {c} · {t}";
    dpi:                         1;
}

* {
    background-color: @background;
    text-color:         @foreground;
    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    enabled:                     true;
    fullscreen:                  false;
    cursor:                      "default";
    spacing:                     0px;
    border-radius:               10px;
    location:                    center;
    anchor:                      center;
    width:                       75%;
    border:                      2px;
    border-color:                @selected-normal-background; 
}

mainbox {
    enabled:                     true;
    children:                    [ "inputbar", "listview"  ];
    background-color:            transparent;
}

inputbar {
    enabled:                      true;
    text-color:                   @selected-normal-foreground;
    background-color:             #0a0a0a95;
    padding:                      5px;
    margin:                       10px;
    border:         1px;
    border-color: @selected-normal-background; 
    border-radius:  5px;
    children:                     [ "entry" ];
}

entry {
    enabled:                      true;
    text-color:                   inherit;
    background-color:             transparent;
}

listview {
    enabled:                     true;
    columns:                     5; 
    lines:                       1; 
    padding:                     26px 36px;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical; /* Vertical arrangement */
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    background-color:            transparent;
    spacing:                     20px;
    
    border:                      0px;
}

element {
    enabled:                     true;
    orientation:                 vertical; 
    expand:                      false;
    spacing:                     0px;
    padding:                     5px 10px;
    border-radius:               10px;
    cursor:                      pointer;
    background-color:            #00000099;
}

element normal.normal {
    background-color:            #00000099;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            #00000080;
    text-color:                  @foreground;
}
element normal.active {
    background-color:            #00000080;
    text-color:                  @foreground;
}

element selected.normal, element selected.active {
   background-color: @normal-background;
   border: 2px;
   border-color: @selected-normal-background;
   text-color: @selected-normal-foreground;
}
element alternate.normal {
    background-color:            #00000080;
    text-color:                  inherit;
}
element alternate.urgent {
    background-color:            #00000080;
    text-color:                  inherit;
}
element alternate.active {
    background-color:            #00000080;
    text-color:                  inherit;
}

element-icon {
    size:                        20%;
    cursor:                      inherit;
    expand:                      false;
    padding:                     0px;
    background-color:            #00000000;
}

element-text {
    cursor:                      inherit;
    background-color:            transparent;
    horizontal-align:            0.5;
    padding:                     0px 0px 10px 0px;
}
